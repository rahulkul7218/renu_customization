 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n\r\n\r\n<div class=\"challan-container\">\r\n    <div class=\"challan-header\"><u>DELIVERY CHALLAN</u></div>\r\n\r\n    <!-- Company Header -->\r\n    <table style=\"margin-bottom: 10px;\">\r\n        <tr>\r\n            <td rowspan=\"4\" style=\"width: 25%; text-align: center;\">\r\n                {% if company.logo_for_printing %}\r\n                    <img src=\"{{ company.logo_for_printing }}\" style=\"max-width: 120px;\">\r\n                {% endif %}\r\n            </td>\r\n            <td colspan=\"3\" style=\"width: 75%; padding: 6px;\">\r\n                <strong>{{ company.company_name }}</strong>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"3\">\r\n               <p><strong>Address: </strong> {{ doc.company_address_display or \"\" }}</p>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"3\"><strong>Tel No. </strong>{{ frappe.db.get_value(\"Company\", doc.company, \"phone_no\") or \"\"}} &nbsp;&nbsp;&nbsp;&nbsp;\r\n                <strong>Email: </strong> {{ frappe.db.get_value(\"Company\", doc.company, \"email\") or \"\"}}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td><strong>GST No.</strong> {{ doc.company_gstin }}</td>\r\n            <td colspan=\"2\"><strong>PAN No.</strong> {{ company.pan }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Delivered To + Challan Details -->\r\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 12px; margin-top: 8px;\">\r\n        <tr>\r\n            <td style=\"width: 50%; border: 1px solid #000; vertical-align: top; padding: 6px;\">\r\n                <strong>Delivered To:&nbsp;&nbsp;</strong>\r\n                {{ doc.customer_name }}\r\n            </td>\r\n            <td style=\"width: 50%; border: 1px solid #000; vertical-align: top; padding: 6px;\">\r\n                <strong>Challan No:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong> {{ doc.name }}<br><br>\r\n                <strong>Challan Date:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong> {{ doc.posting_date }}<br><br>\r\n                <strong>Mode of Transport&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong> {{ doc.mode_of_transport }}<br><br>\r\n                <strong>Customer Challan Ref:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong> {{ doc.customer_challan_ref or doc.name }}<br><br>\r\n                <strong>Customer Challan Dt:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong> {{ doc.customer_challan_dt or doc.posting_date }}<br>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Items Table -->\r\n    <table style=\"margin-top: 10px;\">\r\n        <thead>\r\n            <tr>\r\n                <th>Sr. No</th>\r\n                <th>Description of Goods</th>\r\n                <th>HSN Code</th>\r\n                <th>Qty</th>\r\n                <th>Rate</th>\r\n                <th>Amount</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td class=\"text-left\">{{ item.item_name }}</td>\r\n                <td>{{ item.gst_hsn_code }}</td>\r\n                <td>{{ item.qty }}</td>\r\n                <td>{{ item.rate }}</td>\r\n                <td>{{ item.amount }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Taxes Table -->\r\n    <br>\r\n    <table>\r\n        <thead>\r\n            <tr>\r\n                <th>Sr. No</th>\r\n                <th>Account Head</th>\r\n                <th>Tax Rate %</th>\r\n                <th>Amount</th>\r\n                <th>Total</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.taxes %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td class=\"text-left\">{{ item.account_head }}</td>\r\n                <td>{{ item.rate }}%</td>\r\n                <td>{{ item.tax_amount }}</td>\r\n                <td>{{ item.total }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Total Section -->\r\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 12px; margin-top: 10px;\">\r\n        <tr>\r\n            <td colspan=\"4\" style=\"border: 1px solid #000; padding: 6px;\">\r\n                <strong>Total (In Words):</strong> {{ doc.in_words }}\r\n            </td>\r\n            <td colspan=\"4\" style=\"border: 1px solid #000; padding: 6px; text-align: left;\">\r\n                <strong>Total:</strong> {{ doc.grand_total }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <br>\r\n    \r\n    <table style=\"width: 100%; border: 1px solid #000; border-collapse: collapse; font-size: 12px; font-family: Arial, sans-serif;\">\r\n    <tr>\r\n        <td style=\"width: 35%; border-right: 1px solid #000; padding: 6px; vertical-align: top;\">\r\n            <strong>REMARK :</strong><br>\r\n            <span style=\"font-style: italic;\">Material send after job work <span style=\"color: red; font-weight: bold;\">OR</span><br>\r\n            Material return after rework and testing<br>\r\n            No commercial value</span>\r\n        </td>\r\n        <td style=\"width: 65%; text-align: center; vertical-align: top; padding: 6px;\">\r\n            <strong>For {{ company.company_name }}</strong><br><br><br><br><br>\r\n            Authorised Signatory\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        <td colspan=\"2\" style=\"border-top: 1px solid #000; padding: 6px; text-align: center; font-weight: bold;\">\r\n            PLEASE ACKNOWLEDGE THE RECEIPT AND RETURN THE COPY WITH YOUR SIGNATURE\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"width: 60%; border-right: 1px solid #000; padding: 6px; vertical-align: top;\">\r\n            <strong>Received in good condition by</strong>\r\n        </td>\r\n        <td style=\"width: 40%; padding: 6px; vertical-align: top;\">\r\n            Date Received <br><br>\r\n            Name / Stamp <br><br>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!--<table style=\"width: 100%; border: 1px solid #000; border-collapse: collapse; font-size: 12px; font-family: Arial, sans-serif;\">-->\r\n<!--    <tr>-->\r\n        <!-- Remarks section -->\r\n<!--        <td style=\"width: 70%; border-right: 1px solid #000; padding: 6px; vertical-align: top;\">-->\r\n<!--            <strong>REMARK :</strong><br>-->\r\n<!--            <span style=\"font-style: italic;\">-->\r\n<!--                Material send after job work <span style=\"color: red; font-weight: bold;\">OR</span><br>-->\r\n<!--                Material return after rework and testing<br>-->\r\n<!--                No commercial value-->\r\n<!--            </span>-->\r\n<!--        </td>-->\r\n\r\n        <!-- Company section -->\r\n<!--        <td rowspan=\"2\" style=\"width: 30%; text-align: center; vertical-align: top; padding: 6px;\">-->\r\n<!--            <strong>For {{ company.company_name }}</strong><br><br><br>-->\r\n<!--            Authorised Signatory-->\r\n<!--        </td>-->\r\n<!--    </tr>-->\r\n\r\n    <!-- Full width acknowledgement row -->\r\n<!--    <tr>-->\r\n<!--        <td colspan=\"1\" style=\"border-top: 1px solid #000; padding: 6px; text-align: center;\">-->\r\n<!--            PLEASE ACKNOWLEDGE THE RECEIPT AND RETURN THE COPY WITH YOUR SIGNATURE-->\r\n<!--        </td>-->\r\n<!--    </tr>-->\r\n\r\n    <!-- Received condition row -->\r\n<!--    <tr>-->\r\n<!--        <td style=\"width: 70%; border-right: 1px solid #000; padding: 6px; vertical-align: top;\">-->\r\n<!--            <strong>Received in good condition by</strong>-->\r\n<!--        </td>-->\r\n<!--        <td style=\"width: 30%; padding: 6px; vertical-align: top;\">-->\r\n<!--            Date Received __________________<br><br>-->\r\n<!--            Name / Stamp __________________-->\r\n<!--        </td>-->\r\n<!--    </tr>-->\r\n<!--</table>-->\r\n\r\n\r\n</div>\r\n",
