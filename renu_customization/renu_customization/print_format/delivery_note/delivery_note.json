 "css": "   * {\r\n        font-family: Arial, sans-serif;\r\n    }\r\n    .challan-container {\r\n        border: 1px solid #000;\r\n        padding: 10px;\r\n    }\r\n    .challan-header {\r\n        text-align: center;\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        border-bottom: 2px solid #000;\r\n        padding-bottom: 5px;\r\n        margin-bottom: 10px;\r\n    }\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n    td, th {\r\n        border: 1px solid #000;\r\n        padding: 6px;\r\n        font-size: 12px;\r\n    }\r\n    .company-details td {\r\n        border: none !important;\r\n        padding: 4px;\r\n    }\r\n    .text-left {\r\n        text-align: left;\r\n    }\r\n    .text-right {\r\n        text-align: right;\r\n    }\r\n    .signature-section {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 20px;\r\n        font-size: 12px;\r\n    }",
